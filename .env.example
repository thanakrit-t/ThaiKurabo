# Public values from Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
# Recommended for new projects (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy fallback. Do not set both unless you are migrating keys.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
